    "Only the player whose turn it is may Knock, before playing a card. Each Knock raises the stake by one. After the responses, play your card; you cannot Knock again on that turn." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wer am Zug ist, darf klopfen – bevor die eigene Karte gespielt wird. Jedes Klopfen erhöht den Einsatz um eins. Nach den Antworten spielst du deine Karte. Im selben Zug darfst du nicht erneut klopfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the player whose turn it is may Knock, before playing a card. Each Knock raises the stake by one. After the responses, play your card; you cannot Knock again on that turn."
          }
        }
      }
    },
    "Opponent %lld" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gegner %lld"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opponent %lld"
          }
        }
      }
    },
    "Pass" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass"
          }
        }
      }
    },
    "Pass leaves the round and gives you the previous stake in strokes. If the stake rises from one to two, passing gives you one stroke. If everyone else passes, the knocker wins the round immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Passen verlässt du die Runde und bekommst den vorherigen Einsatz als Striche. Steigt der Einsatz von eins auf zwei, bekommst du beim Passen einen Strich. Passen alle anderen, gewinnt die klopfende Person die Runde sofort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass leaves the round and gives you the previous stake in strokes. If the stake rises from one to two, passing gives you one stroke. If everyone else passes, the knocker wins the round immediately."
          }
        }
      }
    },
