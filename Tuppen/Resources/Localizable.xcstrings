    "A normal round has four tricks. Only the fourth trick wins the round. Winning an earlier trick lets you lead the next one, but does not win the round." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine normale Runde hat vier Stiche. Nur der vierte Stich entscheidet, wer die Runde gewinnt. Wer einen früheren Stich gewinnt, spielt im nächsten zuerst – die Runde ist damit noch nicht gewonnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A normal round has four tricks. Only the fourth trick wins the round. Winning an earlier trick lets you lead the next one, but does not win the round."
          }
        }
      }
    },
    "Ace" : {
      "extractionState" : "manual",
